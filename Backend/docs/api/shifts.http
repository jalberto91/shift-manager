@baseUrl = http://localhost:5080

### UC-03 · Create shift
# Replace <collaboratorId> with an id from GET /api/collaborators.
# Response 201, Location: /api/shifts/<id>
# { "id": "<guid>", "collaboratorId": "<guid>", "date": "2026-03-10", "startTime": "09:00:00", "endTime": "13:00:00" }
POST {{baseUrl}}/api/shifts
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "date": "2026-03-10", "startTime": "09:00", "endTime": "13:00" }

### UC-03 · Create shift that overlaps another one of the same collaborator and day
# Response 409 (conflictingShiftId is the id of the shift it collides with):
# {
#   "title": "Conflict", "status": 409,
#   "detail": "The shift overlaps another shift of the same collaborator.",
#   "errors": { "shift.overlap": ["The shift overlaps another shift of the same collaborator."] },
#   "traceId": "<id>",
#   "conflictingShiftId": "<guid>"
# }
POST {{baseUrl}}/api/shifts
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "date": "2026-03-10", "startTime": "12:00", "endTime": "16:00" }

### UC-03 · Create shift that only touches the boundary of the previous one
# Response 201: intervals are half-open, so 09:00-13:00 and 13:00-17:00 do not overlap.
POST {{baseUrl}}/api/shifts
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "date": "2026-03-10", "startTime": "13:00", "endTime": "17:00" }

### UC-03 · Create shift with several validation errors
# Response 400 (the first error sets detail):
# {
#   "title": "Bad Request", "status": 400,
#   "detail": "Date is required.",
#   "errors": {
#     "shift.date": ["Date is required."],
#     "shift.time-range": ["End time must be later than start time on the same day."]
#   },
#   "traceId": "<id>"
# }
POST {{baseUrl}}/api/shifts
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "startTime": "13:00", "endTime": "09:00" }

### UC-03 · Create shift for an unknown or deactivated collaborator
# Response 400, errors: { "shift.collaborator-unavailable": ["Collaborator does not exist or is inactive."] }
POST {{baseUrl}}/api/shifts
Content-Type: application/json

{ "collaboratorId": "00000000-0000-0000-0000-000000000001", "date": "2026-03-10", "startTime": "09:00", "endTime": "13:00" }

### UC-03 · Create shift with a malformed time
# Response 400 from the framework binder, before the use case runs: the key is the JSON path, not a business code.
# errors: { "$.startTime": ["The JSON value could not be converted to ..."] }
POST {{baseUrl}}/api/shifts
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "date": "2026-03-10", "startTime": "nope", "endTime": "13:00" }

### UC-04 · List shifts without filter
# Response 200, ordered by date and start time. Each shift carries its holiday mark (see UC-05):
# [ { "id": "<guid>", "collaboratorId": "<guid>", "date": "2026-03-10", "startTime": "09:00:00", "endTime": "13:00:00",
#     "holiday": { "status": "None", "name": null, "isGlobal": null } } ]
GET {{baseUrl}}/api/shifts

### UC-04 · List shifts in a date range (both ends included; either one can be omitted)
# Response 200
GET {{baseUrl}}/api/shifts?from=2026-04-01&to=2026-04-30

### UC-05 · List shifts on a nationwide holiday (Collaborator in ES, date 2026-01-01)
# Response 200, element:
# { "date": "2026-01-01", "startTime": "09:00:00", "endTime": "13:00:00",
#   "holiday": { "status": "Holiday", "name": "New Year's Day", "isGlobal": true } }
GET {{baseUrl}}/api/shifts?from=2026-01-01&to=2026-01-01

### UC-05 · List shifts on a regional holiday (Collaborator in ES, date 2026-02-28)
# Response 200, element: the collaborator only has a country, so a regional holiday is marked with isGlobal false.
# { "date": "2026-02-28", "startTime": "09:00:00", "endTime": "13:00:00",
#   "holiday": { "status": "Holiday", "name": "Day of Andalucía", "isGlobal": false } }
GET {{baseUrl}}/api/shifts?from=2026-02-28&to=2026-02-28

### UC-05 · List shifts on an ordinary day
# Response 200, element:
# { "date": "2026-02-10", "startTime": "09:00:00", "endTime": "13:00:00",
#   "holiday": { "status": "None", "name": null, "isGlobal": null } }
GET {{baseUrl}}/api/shifts?from=2026-02-10&to=2026-02-10

### UC-05 · List shifts of collaborators from different countries (AR and MX on 2026-04-02)
# Response 200, each shift uses the country of its collaborator:
# { "date": "2026-04-02", "startTime": "06:00:00", "endTime": "08:00:00",
#   "holiday": { "status": "Holiday", "name": "Day of the Veterans and Fallen of the Malvinas War", "isGlobal": true } }
# { "date": "2026-04-02", "startTime": "08:00:00", "endTime": "15:00:00",
#   "holiday": { "status": "Holiday", "name": "Maundy Thursday", "isGlobal": true } }
GET {{baseUrl}}/api/shifts?from=2026-04-02&to=2026-04-02

### UC-05 · List shifts while Nager.Date does not answer
# Response 200 in about 3 s (client timeout), every shift with the status Unknown; the failure is not cached.
# { "date": "2026-01-01", "startTime": "09:00:00", "endTime": "13:00:00",
#   "holiday": { "status": "Unknown", "name": null, "isGlobal": null } }
GET {{baseUrl}}/api/shifts

### UC-04 · List shifts with from later than to
# Response 400:
# {
#   "title": "Bad Request", "status": 400,
#   "detail": "From date must not be later than to date.",
#   "errors": { "shift.date-range": ["From date must not be later than to date."] },
#   "traceId": "<id>"
# }
GET {{baseUrl}}/api/shifts?from=2026-04-30&to=2026-04-01

### UC-04 · List shifts with a malformed date
# Response 400 from the framework binder: the key is the parameter name.
# errors: { "from": ["The value 'nope' is not valid."] }
GET {{baseUrl}}/api/shifts?from=nope

### UC-04 · Get a shift
# Replace <shiftId> with an id from the list.
# Response 200: { "id": "<guid>", "collaboratorId": "<guid>", "date": "2026-04-02", "startTime": "09:00:00", "endTime": "13:00:00" }
GET {{baseUrl}}/api/shifts/<shiftId>

### UC-04 · Get an unknown shift
# Response 404:
# {
#   "title": "Not Found", "status": 404,
#   "detail": "Shift not found.",
#   "errors": { "shift.not-found": ["Shift not found."] },
#   "traceId": "<id>"
# }
GET {{baseUrl}}/api/shifts/00000000-0000-0000-0000-000000000009

### UC-04 · Update a shift (same body as the create; it does not clash with itself)
# Response 200 with the updated shift. It can also change the collaborator.
PUT {{baseUrl}}/api/shifts/<shiftId>
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "date": "2026-04-02", "startTime": "08:00", "endTime": "15:00" }

### UC-04 · Update a shift so it overlaps another one of the same collaborator and day
# Response 409 (conflictingShiftId is the id of the shift it collides with):
# {
#   "title": "Conflict", "status": 409,
#   "detail": "The shift overlaps another shift of the same collaborator.",
#   "errors": { "shift.overlap": ["The shift overlaps another shift of the same collaborator."] },
#   "traceId": "<id>",
#   "conflictingShiftId": "<guid>"
# }
PUT {{baseUrl}}/api/shifts/<shiftId>
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "date": "2026-04-02", "startTime": "07:00", "endTime": "15:00" }

### UC-04 · Update a shift for an unknown or deactivated collaborator
# Response 400, errors: { "shift.collaborator-unavailable": ["Collaborator does not exist or is inactive."] }
PUT {{baseUrl}}/api/shifts/<shiftId>
Content-Type: application/json

{ "collaboratorId": "00000000-0000-0000-0000-000000000001", "date": "2026-04-02", "startTime": "08:00", "endTime": "15:00" }

### UC-04 · Update a shift with several validation errors
# Response 400:
# {
#   "title": "Bad Request", "status": 400,
#   "detail": "Date is required.",
#   "errors": {
#     "shift.date": ["Date is required."],
#     "shift.time-range": ["End time must be later than start time on the same day."]
#   },
#   "traceId": "<id>"
# }
PUT {{baseUrl}}/api/shifts/<shiftId>
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "startTime": "13:00", "endTime": "09:00" }

### UC-04 · Update an unknown shift
# Response 404, errors: { "shift.not-found": ["Shift not found."] }
PUT {{baseUrl}}/api/shifts/00000000-0000-0000-0000-000000000009
Content-Type: application/json

{ "collaboratorId": "<collaboratorId>", "date": "2026-04-02", "startTime": "09:00", "endTime": "13:00" }

### UC-04 · Delete a shift
# Response 204. Repeating it returns 404 (errors: { "shift.not-found": [...] }): the delete is physical.
DELETE {{baseUrl}}/api/shifts/<shiftId>

### UC-06 · Import shifts from an .xlsx file
# Columns: Email, Fecha, HoraInicio, HoraFin (any order or case). Dates as date cells or yyyy-MM-dd / dd/MM/yyyy text; times as time cells or HH:mm text.
# Template: docs/samples/shifts-import-example.xlsx (six valid shifts for the seeded collaborators, 2026-07-06 to 2026-07-08).
# Response 200, row is the Excel row number:
# { "importedRows": [2, 3, 4, 5, 6, 7], "failedRows": [] }
# The response is also 200 when some rows fail; valid rows are saved and the failed ones are reported, for example:
# {
#   "importedRows": [2, 3],
#   "failedRows": [
#     { "row": 4, "reasons": ["The shift overlaps an earlier row of the same file."] },
#     { "row": 5, "reasons": ["Collaborator does not exist or is inactive."] },
#     { "row": 6, "reasons": ["End time must be later than start time on the same day."] }
#   ]
# }
POST {{baseUrl}}/api/shifts/import
Content-Type: multipart/form-data; boundary=ShiftBoundary

--ShiftBoundary
Content-Disposition: form-data; name="file"; filename="shifts-import-example.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ../samples/shifts-import-example.xlsx
--ShiftBoundary--

### UC-06 · Import the same file again
# Response 200: nothing is imported because every valid row now overlaps the shift saved by the first import.
# { "importedRows": [], "failedRows": [ { "row": 2, "reasons": ["The shift overlaps another shift of the same collaborator."] }, ... ] }
POST {{baseUrl}}/api/shifts/import
Content-Type: multipart/form-data; boundary=ShiftBoundary

--ShiftBoundary
Content-Disposition: form-data; name="file"; filename="shifts-import-example.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ../samples/shifts-import-example.xlsx
--ShiftBoundary--

### UC-06 · Import a row that cannot be read
# Response 200, the row fails and the others are processed. The message names the column:
# { "row": 5, "reasons": ["Column 'Fecha' is missing or has an unreadable value."] }
# Same for Email, HoraInicio and HoraFin. A row of a deactivated collaborator fails with shift.collaborator-unavailable.

### UC-06 · Import a file that is not an .xlsx workbook
# Response 400 (also when the file field is missing):
# {
#   "title": "Bad Request", "status": 400,
#   "detail": "The file is not a readable .xlsx workbook.",
#   "errors": { "shift.import.file": ["The file is not a readable .xlsx workbook."] },
#   "traceId": "<id>"
# }
POST {{baseUrl}}/api/shifts/import
Content-Type: multipart/form-data; boundary=ShiftBoundary

--ShiftBoundary
Content-Disposition: form-data; name="file"; filename="notes.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

not an xlsx
--ShiftBoundary--

### UC-06 · Import a file with missing columns
# Response 400, errors: { "shift.import.columns": ["Missing required columns: HoraInicio, HoraFin."] }

### UC-06 · Import a file larger than 5 MB
# Response 400, errors: { "shift.import.file-too-large": ["The file exceeds the maximum allowed size."] }

### UC-07 · Export shifts of a range to .xlsx
# Response 200, Content-Disposition: attachment; filename="shifts.xlsx". Both bounds are inclusive and optional.
# To save the file: curl -o shifts.xlsx "http://localhost:5080/api/shifts/export?from=2026-03-01&to=2026-03-31"
GET {{baseUrl}}/api/shifts/export?from=2026-03-01&to=2026-03-31

### UC-07 · Export every shift
# Response 200, same file without the date filter.
GET {{baseUrl}}/api/shifts/export

### UC-07 · Export with from after to
# Response 400:
# {
#   "title": "Bad Request", "status": 400,
#   "detail": "<message>",
#   "errors": { "shift.date-range": ["<message>"] },
#   "traceId": "<id>"
# }
GET {{baseUrl}}/api/shifts/export?from=2026-04-01&to=2026-03-01
